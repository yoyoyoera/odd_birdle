{
  "appId": "com.yoyoyo.oddbirdle",
  "appName": "Odd Birdle",
  "webDir": "../portal/app",
  "backgroundColor": "#182223",
  "server": {
    "androidScheme": "https",
    "hostname": "app.oddbirdle"
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "allowsLinkPreview": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK",
      "hidden": true
    }
  }
}
